{
  "name": "offerbound",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "pnpm --filter @offerbound/api run test:integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:format": "prisma format",
    "eval:emails": "pnpm --filter @offerbound/api run eval:emails"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@prisma/client": "6.19.0",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3"
  }
}
