// ---------------------------------------------------------------------------------------------
// Tables (DATA_MODEL §3)
// ---------------------------------------------------------------------------------------------

/// §3.1. The GIN indexes on aliases, domains and ats_slugs are declared here with the names the migration uses.
model Company {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version        Int      @default(1)
  name           String
  normalizedName String   @unique @map("normalized_name")
  aliases        String[] @default([])
  domains        String[] @default([])
  atsSlugs       String[] @default([]) @map("ats_slugs")
  websiteDomain  String?  @map("website_domain")
  groupId        String?  @map("group_id") @db.Uuid
  createdSource  String   @map("created_source")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  group        Company?      @relation("CompanyGroup", fields: [groupId], references: [id], onDelete: SetNull)
  members      Company[]     @relation("CompanyGroup")
  contacts     Contact[]
  leads        Lead[]
  applications Application[]
  events       Event[]
  reviewItems  ReviewItem[]

  @@index([groupId])
  @@index([aliases], type: Gin, map: "company_aliases_gin")
  @@index([domains], type: Gin, map: "company_domains_gin")
  @@index([atsSlugs], type: Gin, map: "company_ats_slugs_gin")
  @@map("company")
}

/// §3.2. email is citext, so uniqueness is case-insensitive.
model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  email     String   @unique @db.Citext
  name      String?
  title     String?
  isAgency  Boolean  @default(false) @map("is_agency")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads   Lead[]

  @@map("contact")
}

/// §3.3. Hand-written: partial unique on job_key (where not null) and the lead_suppressed_reason check.
model Lead {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version               Int               @default(1)
  companyId             String            @map("company_id") @db.Uuid
  intakeBatchId         String            @map("intake_batch_id") @db.Uuid
  title                 String
  jobUrl                String?           @map("job_url")
  jobKey                String?           @map("job_key")
  locationText          String?           @map("location_text")
  country               String?
  workMode              WorkMode          @default(unknown) @map("work_mode")
  remoteFromHomeCountry TriState          @default(unknown) @map("remote_from_home_country")
  sponsorship           TriState          @default(unknown)
  relocation            TriState          @default(unknown)
  sponsorshipText       String?           @map("sponsorship_text")
  compensationText      String?           @map("compensation_text")
  compMin               Decimal?          @map("comp_min") @db.Decimal(12, 2)
  compMax               Decimal?          @map("comp_max") @db.Decimal(12, 2)
  compCurrency          String?           @map("comp_currency") @db.Char(3)
  compPeriod            CompPeriod?       @map("comp_period")
  compIsEstimate        Boolean           @default(false) @map("comp_is_estimate")
  compBasis             String?           @map("comp_basis")
  seniority             Seniority         @default(unknown)
  track                 String?
  fitScore              Int?              @map("fit_score") @db.SmallInt
  fitReason             String?           @map("fit_reason")
  gaps                  String[]          @default([])
  eligible              TriState          @default(unknown)
  eligibilityReason     String?           @map("eligibility_reason")
  status                LeadStatus        @default(new)
  statusChangedAt       DateTime          @map("status_changed_at") @db.Timestamptz(3)
  pipelineState         LeadPipelineState @default(checking) @map("pipeline_state")
  suppressedReason      SuppressedReason? @map("suppressed_reason")
  dismissedReason       String?           @map("dismissed_reason")
  companySeenBefore     Boolean           @default(false) @map("company_seen_before")
  verification          Verification      @default(pending)
  verifiedAt            DateTime?         @map("verified_at") @db.Timestamptz(3)
  pageExcerpt           String?           @map("page_excerpt")
  rankedAt              DateTime?         @map("ranked_at") @db.Timestamptz(3)
  source                LeadSource
  sourceMessageId       String?           @map("source_message_id")
  contactId             String?           @map("contact_id") @db.Uuid
  postedAt              DateTime?         @map("posted_at") @db.Timestamptz(3)
  foundAt               DateTime          @default(now()) @map("found_at") @db.Timestamptz(3)
  applicationId         String?           @unique @map("application_id") @db.Uuid
  notes                 String?
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction)
  intakeBatch   IntakeBatch   @relation(fields: [intakeBatchId], references: [id], onDelete: NoAction)
  sourceMessage GmailMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: NoAction)
  /// The application this lead was converted into (lead.application_id).
  application   Application?  @relation("LeadApplicationId", fields: [applicationId], references: [id], onDelete: SetNull)
  /// The application whose application.lead_id points back at this lead.
  convertedFrom Application?  @relation("ApplicationLeadId")
  events        Event[]
  threadLinks   ThreadLink[]
  reviewItems   ReviewItem[]

  @@index([status, pipelineState, track, fitScore(sort: Desc)])
  @@index([companyId])
  @@index([intakeBatchId])
  @@index([foundAt])
  @@map("lead")
}

/// §3.4. Hand-written: partial unique on job_key (where not null), partial index on follow_up_due.
model Application {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version               Int                @default(1)
  companyId             String             @map("company_id") @db.Uuid
  leadId                String?            @unique @map("lead_id") @db.Uuid
  title                 String
  jobUrl                String?            @map("job_url")
  jobKey                String?            @map("job_key")
  locationText          String?            @map("location_text")
  country               String?
  workMode              WorkMode           @default(unknown) @map("work_mode")
  compensationText      String?            @map("compensation_text")
  sponsorshipText       String?            @map("sponsorship_text")
  status                ApplicationStatus
  statusChangedAt       DateTime           @map("status_changed_at") @db.Timestamptz(3)
  statusBeforeAbandon   ApplicationStatus? @map("status_before_abandon")
  appliedAt             DateTime?          @map("applied_at") @db.Timestamptz(3)
  lastCompanyActivityAt DateTime?          @map("last_company_activity_at") @db.Timestamptz(3)
  lastOutboundAt        DateTime?          @map("last_outbound_at") @db.Timestamptz(3)
  followUpDue           Boolean            @default(false) @map("follow_up_due")
  followUpDueSince      DateTime?          @map("follow_up_due_since") @db.Timestamptz(3)
  followUpDoneAt        DateTime?          @map("follow_up_done_at") @db.Timestamptz(3)
  source                ApplicationSource
  notes                 String?
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: NoAction)
  /// The lead this application points at (application.lead_id).
  lead          Lead?          @relation("ApplicationLeadId", fields: [leadId], references: [id], onDelete: SetNull)
  /// The lead whose lead.application_id points at this application.
  convertedLead Lead?          @relation("LeadApplicationId")
  interviews    Interview[]
  messages      GmailMessage[]
  threadLinks   ThreadLink[]
  events        Event[]
  reviewItems   ReviewItem[]

  @@index([status])
  @@index([companyId])
  @@index([lastCompanyActivityAt])
  @@map("application")
}

/// §3.5. Hand-written: partial unique on ics_uid (where not null).
model Interview {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version         Int             @default(1)
  applicationId   String          @map("application_id") @db.Uuid
  kind            InterviewKind
  status          InterviewStatus
  startsAt        DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?       @map("ends_at") @db.Timestamptz(3)
  timezoneHint    String?         @map("timezone_hint")
  meetingUrl      String?         @map("meeting_url")
  schedulingUrl   String?         @map("scheduling_url")
  location        String?
  interviewers    String[]        @default([])
  icsUid          String?         @map("ics_uid")
  sourceMessageId String?         @map("source_message_id")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceMessage GmailMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@index([applicationId])
  @@map("interview")
}

/// §3.6. Content columns (from_*, to_emails, subject, snippet, body_text) are null unless job-related.
/// to_emails is a nullable column in SQL; Prisma list fields cannot express null, so clearing it
/// to null needs raw SQL (an empty array reads the same as null for the application).
model GmailMessage {
  id                String           @id
  threadId          String           @map("thread_id")
  internalDate      DateTime         @map("internal_date") @db.Timestamptz(3)
  direction         MessageDirection
  labelIds          String[]         @map("label_ids")
  state             MessageState     @default(discovered)
  triageMethod      TriageMethod?    @map("triage_method")
  triageRule        String?          @map("triage_rule")
  triageConfidence  Float?           @map("triage_confidence") @db.Real
  category          EmailCategory?
  extractConfidence Float?           @map("extract_confidence") @db.Real
  extraction        Json?
  icsEvents         Json?            @map("ics_events")
  fromEmail         String?          @map("from_email")
  fromName          String?          @map("from_name")
  toEmails          String[]         @map("to_emails")
  subject           String?
  snippet           String?
  bodyText          String?          @map("body_text")
  summary           String?
  applicationId     String?          @map("application_id") @db.Uuid
  /// Two meanings, by state: failed triage attempts while `discovered` (the fifth fails the
  /// message), then, once `job_related`, how many times the resend sweep sent it to extraction
  /// again (reset to 0 when triage decides it; the fifth resend fails it). Never read for any
  /// other state.
  attempts          Int              @default(0)
  lastError         String?          @map("last_error")
  discoveredAt      DateTime         @default(now()) @map("discovered_at") @db.Timestamptz(3)
  /// When the message last left a stage. While `job_related` it is a heartbeat or a due time: each
  /// extraction attempt stamps it, and a Gmail Retry-After moves it to when the deferred job is due.
  /// The resend sweep treats the job as lost only once it is 10 minutes old.
  processedAt       DateTime?        @map("processed_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  leads         Lead[]
  interviews    Interview[]
  events        Event[]
  reviewItems   ReviewItem[]
  intakeBatches IntakeBatch[]
  llmCalls      LlmCall[]

  @@index([state, internalDate])
  @@index([threadId])
  @@index([applicationId])
  @@map("gmail_message")
}

/// §3.7. Hand-written: thread_link_target check (application_id or lead_id is set).
model ThreadLink {
  threadId      String   @id @map("thread_id")
  applicationId String?  @map("application_id") @db.Uuid
  leadId        String?  @map("lead_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("thread_link")
}

/// §3.8. entity_key is not a column: the idempotency unique index is an expression index,
/// (message_id, type, coalesce(application_id::text, lead_id::text, '-')) where message_id is not null.
model Event {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String?   @map("application_id") @db.Uuid
  leadId          String?   @map("lead_id") @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  type            EventType
  actor           Actor
  occurredAt      DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  messageId       String?   @map("message_id")
  summary         String
  data            Json?
  changeSet       Json?     @map("change_set")
  undoable        Boolean
  undoneAt        DateTime? @map("undone_at") @db.Timestamptz(3)
  undoneByEventId String?   @map("undone_by_event_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  message       GmailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  undoneByEvent Event?        @relation("EventUndoneBy", fields: [undoneByEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  undoes        Event[]       @relation("EventUndoneBy")

  @@index([applicationId, occurredAt(sort: Desc)])
  @@index([leadId, occurredAt(sort: Desc)])
  @@map("event")
}

/// §3.9. Hand-written: partial unique (message_id, kind) where state = 'open' and message_id is not null.
model ReviewItem {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          ReviewKind
  state         ReviewState @default(open)
  messageId     String?     @map("message_id")
  applicationId String?     @map("application_id") @db.Uuid
  leadId        String?     @map("lead_id") @db.Uuid
  companyId     String?     @map("company_id") @db.Uuid
  confidence    Float?      @db.Real
  plan          Json?
  candidates    Json        @default("[]")
  reasons       String[]    @default([])
  resolution    Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt    DateTime?   @map("resolved_at") @db.Timestamptz(3)

  message     GmailMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  application Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([state, createdAt(sort: Desc)])
  @@map("review_item")
}

/// §3.10. Hand-written: partial unique on file_hash (where not null).
model IntakeBatch {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        IntakeBatchKind
  searchRunId String?         @map("search_run_id") @db.Uuid
  messageId   String?         @map("message_id")
  fileHash    String?         @map("file_hash")
  counts      Json
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  finalizedAt DateTime?       @map("finalized_at") @db.Timestamptz(3)

  searchRun SearchRun?    @relation(fields: [searchRunId], references: [id], onDelete: NoAction)
  message   GmailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  leads     Lead[]

  @@map("intake_batch")
}

/// §3.11
