// Offerbound data model. DATA_MODEL.md is the authority for columns, enums, defaults and indexes.
//
// Prisma 6 cannot express partial unique indexes, expression indexes or check constraints, and it
// does not manage extensions here. Those are hand-written in migrations/0001_init/migration.sql
// and listed in MANUAL_SQL.md. Check every new migration for DROP statements against that list.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

