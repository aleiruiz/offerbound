/// §3.16
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("setting")
}

/// §3.17
model DailyActivity {
  day           DateTime @id @db.Date
  outreachCount Int      @default(0) @map("outreach_count")
  prepMinutes   Int      @default(0) @map("prep_minutes")
  followUps     Int      @default(0) @map("follow_ups")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("daily_activity")
}

/// §3.18
model LlmCall {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose           LlmPurpose
  model             String
  inputTokens       Int           @map("input_tokens")
  cachedInputTokens Int           @map("cached_input_tokens")
  outputTokens      Int           @map("output_tokens")
  webSearchCalls    Int           @default(0) @map("web_search_calls")
  costMicros        BigInt?       @map("cost_micros")
  latencyMs         Int           @map("latency_ms")
  status            LlmCallStatus
  errorCode         String?       @map("error_code")
  requestId         String?       @map("request_id")
  messageId         String?       @map("message_id")
  searchRunId       String?       @map("search_run_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  message   GmailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  searchRun SearchRun?    @relation(fields: [searchRunId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([purpose, createdAt])
  @@map("llm_call")
}
