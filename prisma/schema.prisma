/// §3.14 (singleton). Hand-written: gmail_connection_singleton check (id = 1).
model GmailConnection {
  id                   Int              @id @db.SmallInt
  googleSub            String           @map("google_sub")
  email                String
  scopes               String[]
  refreshTokenEnc      String?          @map("refresh_token_enc")
  accessTokenEnc       String?          @map("access_token_enc")
  accessTokenExpiresAt DateTime?        @map("access_token_expires_at") @db.Timestamptz(3)
  status               ConnectionStatus
  historyId            String?          @map("history_id")
  startedAt            DateTime?        @map("started_at") @db.Timestamptz(3)
  lastSyncAt           DateTime?        @map("last_sync_at") @db.Timestamptz(3)
  lastSyncError        String?          @map("last_sync_error")
  backfillSince        DateTime         @map("backfill_since") @db.Date
  backfillState        BackfillState    @default(not_started) @map("backfill_state")
  backfillPageToken    String?          @map("backfill_page_token")
  backfillListed       Int              @default(0) @map("backfill_listed")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("gmail_connection")
}

