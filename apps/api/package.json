{
  "name": "@offerbound/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@offerbound/source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "eval:emails": "tsx --conditions=@offerbound/source scripts/eval-emails.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@offerbound/contracts": "workspace:*",
    "@offerbound/domain": "workspace:*",
    "@prisma/client": "6.19.0",
    "fastify": "^5",
    "google-auth-library": "^11.3.2",
    "openai": "^6",
    "pg-boss": "^12",
    "pino": "^10",
    "zod": "^4"
  }
}
