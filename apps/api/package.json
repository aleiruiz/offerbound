{
  "name": "@offerbound/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@offerbound/source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "eval:emails": "tsx --conditions=@offerbound/source scripts/eval-emails.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@googleapis/gmail": "^22.0.2",
    "@offerbound/contracts": "workspace:*",
    "@offerbound/domain": "workspace:*",
    "@prisma/client": "6.19.0",
    "fastify": "^5",
    "google-auth-library": "^11.3.2",
    "html-to-text": "^10.0.1",
    "ical.js": "^2.2.1",
    "ipaddr.js": "^2.5.0",
    "luxon": "^3.7.2",
    "mammoth": "^1.13.0",
    "openai": "^6",
    "pdf-parse": "^2.4.5",
    "pg-boss": "^12",
    "pino": "^10",
    "undici": "^8.12.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.6"
  }
}
